# Copy to .env and fill in only the providers you want to call.
# The application starts when these are empty. Never commit the filled-in file.

OPENAI_API_KEY=
ANTHROPIC_API_KEY=
XAI_API_KEY=
MISTRAL_API_KEY=

# Optional overrides. Defaults live in src/main/resources/application.yml.
# OPENAI_MODEL=gpt-4o-mini
# ANTHROPIC_MODEL=claude-haiku-4-5
# ANTHROPIC_MAX_TOKENS=1024
# XAI_MODEL=grok-4.7
# XAI_BASE_URL=https://api.x.ai
# MISTRAL_MODEL=mistral-small-latest
# OLLAMA_ENABLED=true
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_MODEL=llama3.2
# LLM_CONNECT_TIMEOUT=5s
# LLM_READ_TIMEOUT=120s

# Retrieval. Docker Compose reads this file automatically. An IDE or ./mvnw spring-boot:run does not:
# put the same variables in the run configuration or export them in the shell.
# Host name: localhost when the app runs on the host and Postgres is published on 5432.
# Host name postgres when the app runs as the Compose service (already set in compose.yaml).
# Do not use localhost inside the app container. Use host.docker.internal only to reach Postgres on the host.
# SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/llm
# SPRING_DATASOURCE_USERNAME=llm
# SPRING_DATASOURCE_PASSWORD=llm
# EMBEDDING_PROVIDER=transformers
# OPENAI_EMBEDDING_MODEL=text-embedding-3-small
# OLLAMA_EMBEDDING_MODEL=bge-m3
# EMBEDDING_DIMENSIONS=384
# RAG_LOAD_SAMPLES=false
# RAG_TOP_K=4
# RAG_SIMILARITY_THRESHOLD=0.10
# RAG_CHUNK_SIZE=120
