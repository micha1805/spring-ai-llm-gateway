# Copy to .env and fill in only the providers you want to call.
# The application starts when these are empty. Never commit the filled-in file.

OPENAI_API_KEY=
ANTHROPIC_API_KEY=
XAI_API_KEY=
MISTRAL_API_KEY=

# Optional overrides. Defaults live in src/main/resources/application.yml.
# OPENAI_MODEL=gpt-4o-mini
# ANTHROPIC_MODEL=claude-haiku-4-5
# ANTHROPIC_MAX_TOKENS=1024
# XAI_MODEL=grok-4.7
# XAI_BASE_URL=https://api.x.ai
# MISTRAL_MODEL=mistral-small-latest
# OLLAMA_ENABLED=true
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_MODEL=llama3.2
# LLM_CONNECT_TIMEOUT=5s
# LLM_READ_TIMEOUT=120s
